# Copiar estas variables al entorno de despliegue (el proyecto no carga .env automáticamente).
# SECRET_KEY: generar un valor aleatorio distinto en cada despliegue.
SECRET_KEY=
DATABASE_URL=sqlite:///app.db
FORCE_HTTPS=0
TRUST_PROXY=0
HSTS_MAX_AGE=31536000
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=local
